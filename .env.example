# AI Due Diligence Copilot
# Authentication data. In production, point this at your central auth database.
AUTH_DATABASE_URL=sqlite:///./auth.db
DD_AUTH_SECRET=replace-with-a-long-random-secret
DD_AUTH_TOKEN_TTL=604800

# Local AI
OLLAMA_BASE_URL=http://localhost:11434
RAG_LLM_MODEL=qwen3
RAG_EMBEDDING_MODEL=mxbai-embed-large

# Local workspace / RAG storage
RAG_DATA_DIR=./data
RAG_CHROMA_DIR=./chroma_db
RAG_MAX_FILE_SIZE_MB=2048

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

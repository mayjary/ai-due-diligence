# AI Due Diligence Copilot
# Authentication data. In production, point this at your central auth database.
AUTH_DATABASE_URL=sqlite:///./auth.db
DD_AUTH_SECRET=replace-with-a-long-random-secret
DD_AUTH_TOKEN_TTL=604800
DD_ADMIN_EMAIL=admin@ddcopilot.local
DD_ADMIN_PASSWORD=Admin12345!
DD_ADMIN_NAME=Workspace Admin
DD_ADMIN_ORGANIZATION=Local Workspace

# Local AI — Ollama is required; there are no OpenAI/Anthropic keys in this stack.
OLLAMA_BASE_URL=http://127.0.0.1:11434
RAG_LLM_MODEL=qwen3
RAG_EMBEDDING_MODEL=mxbai-embed-large

# Local workspace / RAG storage
RAG_DATA_DIR=./data
RAG_CHROMA_DIR=./chroma_db
RAG_MAX_FILE_SIZE_MB=2048

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
